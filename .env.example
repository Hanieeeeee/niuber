# Ring Records environment example
# Copy to .env and adjust.

# HTTP port for the API + static frontend
PORT=8787

# SQLite database path (created on first run)
RR_DB_PATH=./data/ring-records.db

# Background sync interval (official site is HTML — default 30 minutes)
RR_SYNC_INTERVAL_MINUTES=30

# Optional token to protect POST /api/admin/sync
RR_ADMIN_TOKEN=change-me-if-you-expose-post-sync

# Set to 1 to disable in-process scheduler (use external cron instead)
RR_DISABLE_SCHEDULER=0

# User-Agent sent to nuerburgring.de (be a good citizen)
RR_HTTP_USER_AGENT=RingRecords/1.0 (+https://example.invalid; independent archive)

# Fetch timeout / retry
RR_HTTP_TIMEOUT_MS=20000
RR_HTTP_RETRIES=3

# Mark data stale after this many minutes without a successful sync
RR_STALE_AFTER_MINUTES=180
